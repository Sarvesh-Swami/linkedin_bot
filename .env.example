# ==========================================================================
# Copy this file to `.env` (same folder) and fill in YOUR OWN LinkedIn
# account. `.env` is gitignored -- never commit it.
#
#     copy .env.example .env        (Windows PowerShell)
#     cp   .env.example .env        (macOS / Linux)
# ==========================================================================

# Credentials used to auto-fill the LinkedIn sign-in form.
# Leave them blank to log in entirely by hand in the browser window --
# the bot pauses and waits for you either way when 2FA/CAPTCHA appears.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Optional but recommended. Your LinkedIn profile handle, i.e. the last part
# of your profile URL: linkedin.com/in/<handle>/ . A full /in/ URL also works.
# When set, the bot refuses to reuse a saved session that belongs to a
# different account and logs you in fresh instead.
LINKEDIN_ACCOUNT=

# Optional escape hatch: set to 1 only if you deliberately copy YOUR OWN
# session.json between your own devices and want the ownership check skipped.
# LINKEDIN_ALLOW_FOREIGN_SESSION=1
