# Saved browser session (live LinkedIn cookies for YOUR account).
# It is written by linkedin_login.py on first login and reused on this
# device only -- anyone else's copy is detected and discarded at run time.
session.json
session*.json
sessions/
browser_profile/
linkedin_state/

